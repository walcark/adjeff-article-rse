# pixi environments
.pixi/*
!.pixi/config.toml

# everything generate/ produces
results/

# the Smart-G auxiliary dataset, downloaded by `pixi run download-auxdata`
inputs/smartg_auxdata/

# python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# credentials must never be committed: the loader reads them from
# ~/.config/adjeff-article/credentials.toml, from the environment or
# from ~/.netrc, all outside this tree.  These patterns are a net for a
# file created here by mistake, not a supported location.
credentials.toml
*credentials*.toml
.netrc
