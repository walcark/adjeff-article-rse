#!/usr/bin/env bash
# Generate the figures of Article 1.  A target is the printed figure number.
#
#   bash makefig                     # every target of ALL_FIGURES
#   bash makefig figure5             # one of them
#
# figure1, figure4, figure16, figure18 and figure19 are built outside this
# repository.  elevation_low_aot is not a figure of the article.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIGS="$REPO_ROOT/generate"

export SMARTG_DIR_AUXDATA="$REPO_ROOT/inputs/smartg_auxdata"

mkdir -p "$REPO_ROOT/results/figures" "$REPO_ROOT/results/tables"

run_figure() {
    local fig="$1"
    shift
    echo ">>> $fig"
    case "$fig" in
    figureC1) python "$FIGS/figures/figureC1.py" ;;
    figureC2) python "$FIGS/figures/figureC2.py" ;;
    figure2) python "$FIGS/figures/figure2.py" ;;
    figure3) python "$FIGS/figures/figure3.py" ;;
    figure5)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure5 \
            --aot 0.1 0.3 0.5 0.7 \
            --rh 50.0 --h 0.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species blackcar --remove_rayleigh
        ;;
    figure6)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure6 \
            --aot 0.1 0.3 0.5 0.7 \
            --rh 50.0 --h 0.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate --remove_rayleigh
        ;;
    figure7)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure7 \
            --aot 0.1 0.3 0.5 0.7 \
            --rh 95.0 --h 0.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate --remove_rayleigh
        ;;
    figure8)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure8 \
            --aot 0.1 0.3 0.5 0.7 \
            --rh 50.0 --h 0.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species seasalt --remove_rayleigh
        ;;
    figure9)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure9 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 --wl 560.0 865.0 2190.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species blackcar --remove_rayleigh
        ;;
    figure10)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure10 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 --wl 560.0 865.0 2190.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate --remove_rayleigh
        ;;
    figure11)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure11 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 --wl 560.0 865.0 2190.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species seasalt --remove_rayleigh
        ;;
    # No --remove_rayleigh from here on: the published encircled energy
    # includes the molecules.
    figure12)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure12 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 --wl 560.0 --href 1.0 2.0 4.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate
        ;;
    figure13)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure13 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 1.5 3.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate
        ;;
    figure14)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure14 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 0.0 8.0 16.0 --saa 0.0 --vaa 0.0 \
            --species sulphate
        ;;
    figure15)
        python "$FIGS/figures/figure5_15.py" \
            --figure figure15 \
            --aot 0.4 \
            --rh 50.0 --h 0.0 --wl 560.0 --href 2.0 \
            --sza 0.0 40.0 80.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate
        ;;
    elevation_low_aot)
        python "$FIGS/figures/figure5_15.py" \
            --figure elevation_low_aot \
            --aot 0.05 \
            --rh 50.0 --h 0.0 1.5 3.0 --wl 560.0 --href 2.0 \
            --sza 40.0 --vza 8.0 --saa 0.0 --vaa 0.0 \
            --species sulphate
        ;;
    figure17) python "$FIGS/figures/figure17.py" "$@" ;;
    figures20-21) python "$FIGS/figures/figures20-21.py" ;;
    table_aot_sensitivity)
        python "$FIGS/reviews/table_aot_sensitivity.py" \
            --aot-ref 0.4 --aot-delta 0.2 \
            --wl 490.0 560.0 665.0 865.0 1610.0 2190.0 \
            --rh 50.0 --h 0.0 --href 2.0 \
            --sza 40.0 --vza 0.0 --saa 0.0 --vaa 0.0 \
            --species sulphate
        ;;
    *)
        echo "Unknown figure: $fig" >&2
        exit 1
        ;;
    esac
}

ALL_FIGURES=(
    figure2 figure3
    figureC1 figureC2
    figure5 figure6 figure7 figure8 figure9 figure10 figure11
    figure12 figure13 figure14 figure15
    figure17
    figures20-21
    table_aot_sensitivity
)

if [ $# -eq 0 ]; then
    for fig in "${ALL_FIGURES[@]}"; do
        run_figure "$fig"
    done
else
    run_figure "$@"
fi

echo "Done. Figures written to results/figures/"
